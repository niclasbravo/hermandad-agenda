# Copia este archivo como .env y ajusta los valores. .env nunca se sube al repositorio.
MYSQL_ROOT_PASSWORD=cambiar-esta-clave-root
DB_USUARIO=agenda
DB_CONTRASENA=cambiar-esta-clave
# Perfil de Spring: demo (con datos de demostración y simulador), dev o prod
SPRING_PROFILES_ACTIVE=demo
# Puerto del sitio en tu equipo
PUERTO_WEB=8080
# Solo en la nube (docker-compose.nube.yml): dominio con HTTPS, por ejemplo 3-91-20-15.sslip.io
DOMINIO=
# Puerto de MySQL en tu equipo (cámbialo si ya tienes un MySQL local usando el 3306)
PUERTO_MYSQL=3306

# Mensajería: simulador (por defecto) o whatsapp
MENSAJERIA_PROVEEDOR=simulador
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
# Demo con el número de prueba de Meta: solo estos celulares reciben WhatsApp real (separados por coma).
# Los demás (pacientes ficticios) van al simulador. Déjalo vacío en producción.
WHATSAPP_NUMEROS_PERMITIDOS=

# Solo producción: primera cuenta de Administración si la base no tiene usuarios
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_CONTRASENA=
